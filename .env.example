# ==============================================================================
# AuraVisa Global - Environment Configuration Template
# ==============================================================================

# AI STUDIO & RUNTIME DEFAULTS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for live Gemini AI visa consultations & grounded answers.
# In production, set as server-side environment variable. Never expose via VITE_.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Base URL where this application is hosted (e.g., https://your-app.vercel.app)
APP_URL="http://localhost:3000"

# SERVER & SECURITY CONFIGURATION (Server-side only)
# ------------------------------------------------------------------------------
PORT="3000"
NODE_ENV="production"
# SESSION_SECRET: Minimum 32-character random string for signing HTTP sessions & tokens.
SESSION_SECRET="replace-with-a-very-long-random-secret-key-for-sessions-32-chars"
# FRONTEND_ORIGIN: Allowed origin for CORS headers (especially when frontend is decoupled)
FRONTEND_ORIGIN="https://your-frontend.vercel.app"

# DATABASE PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development / Serverless ephemeral demo default:
DATABASE_URL="file:./prisma/dev.db"

# Production PostgreSQL (Supabase, Neon, AWS RDS, Cloud SQL):
# When using PostgreSQL, update provider to "postgresql" in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/auravisa?schema=public&sslmode=require"

# STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Local/Container: Path on disk.
# On Vercel: Automatically defaults to /tmp/auravisa_uploads in serverless runtime.
STORAGE_PATH="./storage/uploads"

# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Leave empty when deploying frontend and serverless functions
# to the same Vercel project (relative /api requests).
# If hosting the Express backend on Cloud Run, Railway, or Render, set to your backend URL:
# VITE_API_BASE_URL="https://api.auravisa.com"
VITE_API_BASE_URL=""
